<Window x:Class="AutoPublishRecorder.RecorderWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="流程录制器 — 操作目标程序生成 workflow"
        Width="920" Height="660" MinWidth="800" MinHeight="540"
        WindowStyle="None" ResizeMode="CanResize"
        WindowStartupLocation="CenterOwner"
        Closed="Window_Closed">

    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="0"
                      ResizeBorderThickness="6"
                      CornerRadius="0"
                      GlassFrameThickness="0" />
    </WindowChrome.WindowChrome>

    <Grid TextElement.Foreground="{StaticResource TextBrush}">
        <!-- 背景：清新渐变 + 光斑（液态玻璃透出颜色，右橙左蓝呼应录制语义） -->
        <Grid.Background>
            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                <GradientStop Color="#F0F8FE" Offset="0" />
                <GradientStop Color="#E8F5FB" Offset="0.5" />
                <GradientStop Color="#FDF6F0" Offset="1" />
            </LinearGradientBrush>
        </Grid.Background>

        <Grid.RowDefinitions>
            <RowDefinition Height="44" />
            <RowDefinition Height="*" />
            <RowDefinition Height="30" />
        </Grid.RowDefinitions>

        <Ellipse Width="420" Height="420" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,-160,-140">
            <Ellipse.Fill>
                <RadialGradientBrush>
                    <GradientStop Color="#59FFB877" Offset="0" />
                    <GradientStop Color="#00FFB877" Offset="1" />
                </RadialGradientBrush>
            </Ellipse.Fill>
        </Ellipse>
        <Ellipse Width="400" Height="400" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="-140,80,0,-120">
            <Ellipse.Fill>
                <RadialGradientBrush>
                    <GradientStop Color="#59A8CCFF" Offset="0" />
                    <GradientStop Color="#00A8CCFF" Offset="1" />
                </RadialGradientBrush>
            </Ellipse.Fill>
        </Ellipse>

        <!-- ===================== 自绘标题栏 ===================== -->
        <Grid Grid.Row="0" Background="Transparent" MouseLeftButtonDown="TitleBar_MouseDown">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0" Orientation="Horizontal" Margin="14,0,0,0" VerticalAlignment="Center">
                <Border Width="22" Height="22" CornerRadius="7"
                        Background="{StaticResource RecordGradient}" >
                    <TextBlock Text="&#xE895;" FontFamily="Segoe MDL2 Assets" FontSize="11"
                               Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Border>
                <TextBlock Text="流程录制器 — 操作目标程序生成 workflow" FontSize="14" FontWeight="Bold"
                           Foreground="{StaticResource TextBrush}" Margin="10,0,0,0"
                           VerticalAlignment="Center" />
            </StackPanel>

            <StackPanel Grid.Column="2" Orientation="Horizontal" Margin="0,0,8,0">
                <Button Style="{StaticResource CaptionButton}" Click="Minimize_Click" ToolTip="最小化">
                    <TextBlock Text="&#xE921;" FontFamily="Segoe MDL2 Assets" FontSize="10" />
                </Button>
                <Button Style="{StaticResource CaptionButton}" Click="Maximize_Click" ToolTip="最大化">
                    <TextBlock Text="&#xE922;" FontFamily="Segoe MDL2 Assets" FontSize="10" />
                </Button>
                <Button Style="{StaticResource CloseCaptionButton}" Click="Close_Click" ToolTip="关闭">
                    <TextBlock Text="&#xE8BB;" FontFamily="Segoe MDL2 Assets" FontSize="10" />
                </Button>
            </StackPanel>
        </Grid>

        <!-- ===================== 内容区 ===================== -->
        <Grid Grid.Row="1" Margin="16,10,16,6">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- 录制控制卡片 -->
            <Border Grid.Row="0" Style="{StaticResource GlassCard}" Padding="14,10" Margin="0,0,0,10">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="220" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="目标窗口标题:" VerticalAlignment="Center" FontSize="13"
                               Foreground="{StaticResource SubTextBrush}" />
                    <TextBox Grid.Column="1" x:Name="TargetTitleBox" Margin="6,0,14,0"
                             Text="主题模板发布"
                             ToolTip="只录制该标题窗口内的操作（模糊匹配）" />
                    <Button Grid.Column="2" x:Name="StartBtn" Content="开始录制"
                            Style="{StaticResource RecordButton}" Click="Start_Click" />
                    <Button Grid.Column="3" x:Name="StopBtn" Content="停止" Margin="10,0,0,0"
                            IsEnabled="False" Click="Stop_Click" />
                    <Border Grid.Column="4" Background="#1A1FA6E8" CornerRadius="999" Padding="12,5"
                            HorizontalAlignment="Right" VerticalAlignment="Center">
                        <TextBlock x:Name="RecordStatus" Text="就绪 — 输入目标窗口标题后点击「开始录制」"
                                   HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="11"
                                   Foreground="{StaticResource AccentDeepBrush}" />
                    </Border>
                </Grid>
            </Border>

            <!-- 步骤列表卡片 -->
            <Border Grid.Row="1" Style="{StaticResource GlassCard}" Padding="12">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <TextBlock Grid.Row="0" Text="录制的步骤（自上而下依次执行）" FontSize="12" FontWeight="Bold"
                               Foreground="{StaticResource SubTextBrush}" Margin="2,0,0,6" />
                    <Border Grid.Row="1" Background="#59FFFFFF" CornerRadius="12" Padding="4">
                        <ListBox x:Name="StepList" Background="Transparent" BorderThickness="0"
                                 Foreground="{StaticResource TextBrush}" FontSize="13"
                                 ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Grid Margin="2,1">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="110" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="{Binding Kind}" FontWeight="Bold"
                                                   Foreground="{StaticResource AccentDeepBrush}"
                                                   VerticalAlignment="Center" />
                                        <StackPanel Grid.Column="1" Orientation="Horizontal"
                                                    VerticalAlignment="Center">
                                            <TextBlock Text="{Binding Locator}"
                                                       Foreground="{StaticResource TextBrush}" />
                                            <TextBlock Text="{Binding Value}"
                                                       Foreground="{StaticResource SubTextBrush}"
                                                       Margin="10,0,0,0" />
                                        </StackPanel>
                                        <StackPanel Grid.Column="2" Orientation="Horizontal">
                                            <Button Content="@主题" Click="SetToTheme_Click"
                                                    Padding="9,2" Margin="2,0" FontSize="11"
                                                    ToolTip="把该步骤的值设为 @theme（多主题发布时每轮自动注入当前主题，并开启回车提交）">
                                                <Button.Style>
                                                    <Style TargetType="Button">
                                                        <Setter Property="Visibility" Value="Collapsed" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding Kind}" Value="SetValue">
                                                                <Setter Property="Visibility" Value="Visible" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Button.Style>
                                            </Button>
                                            <Button Content="✕" Click="DeleteStep_Click"
                                                    Padding="9,2" Margin="2,0" FontSize="11" ToolTip="删除该步骤" />
                                        </StackPanel>
                                    </Grid>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </Border>
                </Grid>
            </Border>

            <!-- 工具行 -->
            <Grid Grid.Row="2" Margin="0,10,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="等待:" VerticalAlignment="Center" FontSize="13"
                               Foreground="{StaticResource SubTextBrush}" />
                    <TextBox x:Name="WaitSecBox" Width="44" Margin="6,0,4,0" Text="2" />
                    <TextBlock Text="秒" VerticalAlignment="Center" FontSize="13"
                               Foreground="{StaticResource SubTextBrush}" Margin="0,0,8,0" />
                    <Button Content="插入等待" Click="InsertWait_Click" Padding="15,6" FontSize="12" Margin="0,0,8,0" />
                    <Button Content="插入结果检测" Click="InsertDetect_Click" Padding="15,6" FontSize="12" Margin="0,0,8,0"
                            ToolTip="录制发布动作后手动插入：检测目标程序界面变化判定完成" />
                    <Button Content="合并勾选→CheckFiles" Click="MergeToggles_Click" Padding="15,6" FontSize="12" Margin="0,0,8,0"
                            ToolTip="把连续录制的树节点 Toggle 合并为一个 CheckFiles 步骤：读整棵树勾选、自动展开父目录、缺失文件宽容（不同主题文件结构不同时更稳）" />
                    <Button Content="清空" Click="Clear_Click" Padding="15,6" FontSize="12"
                            ToolTip="清空已录制的步骤" />
                </StackPanel>
                <TextBlock Grid.Column="1" Text="提示: 点按钮/列表项=Click · 点复选框=Toggle · Ctrl+点树节点=Expand · 输入后按 Enter/Tab=SetValue"
                           HorizontalAlignment="Right" VerticalAlignment="Center" FontSize="11"
                           Foreground="{StaticResource SubTextBrush}" Margin="10,0,10,0" TextWrapping="Wrap" />
                <Button Grid.Column="2" x:Name="SaveBtn" Content="保存为 workflow.json"
                        Style="{StaticResource PrimaryButton}" Click="Save_Click" />
            </Grid>
        </Grid>

        <!-- ===================== 底部状态栏 ===================== -->
        <Border Grid.Row="2" Background="#59FFFFFF" BorderThickness="0,1,0,0" BorderBrush="#331FA6E8">
            <TextBlock x:Name="BottomText" Margin="16,0" Text="多主题发布: 把「主题搜索」步骤点「@主题」设为 @theme，每轮自动注入当前主题；发布动作请确认录到了 Click（弹窗/确认框也会录制）"
                       FontSize="12" VerticalAlignment="Center" Foreground="{StaticResource SubTextBrush}" />
        </Border>
    </Grid>
</Window>
