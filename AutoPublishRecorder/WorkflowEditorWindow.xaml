<Window x:Class="AutoPublishRecorder.WorkflowEditorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:sys="clr-namespace:System;assembly=System.Runtime"
        xmlns:models="clr-namespace:AutoPublishCore.Models"
        Title="流程编辑 — workflow.json"
        Width="1020" Height="700" MinWidth="900" MinHeight="560"
        WindowStyle="None" ResizeMode="CanResize"
        WindowStartupLocation="CenterOwner">

    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="0"
                      ResizeBorderThickness="6"
                      CornerRadius="0"
                      GlassFrameThickness="0" />
    </WindowChrome.WindowChrome>

    <Window.Resources>
        <!-- 步骤类型枚举值（供类型列下拉选择） -->
        <ObjectDataProvider x:Key="StepKinds" MethodName="GetValues" ObjectType="{x:Type sys:Enum}">
            <ObjectDataProvider.MethodParameters>
                <x:Type TypeName="models:StepKind" />
            </ObjectDataProvider.MethodParameters>
        </ObjectDataProvider>
        <!-- 失败策略可选值 -->
        <x:Array Type="{x:Type sys:String}" x:Key="FailStrategies">
            <sys:String>stop</sys:String>
            <sys:String>continue</sys:String>
            <sys:String>retry</sys:String>
        </x:Array>
    </Window.Resources>

    <Grid TextElement.Foreground="{StaticResource TextBrush}">
        <Grid.Background>
            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                <GradientStop Color="#D8F3FAFF" Offset="0" />
                <GradientStop Color="#CCE4F4FF" Offset="0.5" />
                <GradientStop Color="#D6EDFBFF" Offset="1" />
            </LinearGradientBrush>
        </Grid.Background>

        <Grid.RowDefinitions>
            <RowDefinition Height="44" />
            <RowDefinition Height="*" />
            <RowDefinition Height="30" />
        </Grid.RowDefinitions>

        <!-- ===================== 自绘标题栏 ===================== -->
        <Grid Grid.Row="0" Background="Transparent" MouseLeftButtonDown="TitleBar_MouseDown">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0" Orientation="Horizontal" Margin="14,0,0,0" VerticalAlignment="Center">
                <Border Width="22" Height="22" CornerRadius="7"
                        Background="{StaticResource AccentBrush}" Effect="{StaticResource SoftShadow}">
                    <TextBlock Text="&#xE70F;" FontFamily="Segoe MDL2 Assets" FontSize="11"
                               Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Border>
                <TextBlock Text="流程编辑 — workflow.json" FontSize="14" FontWeight="Bold"
                           Foreground="{StaticResource TextBrush}" Margin="10,0,0,0"
                           VerticalAlignment="Center" />
            </StackPanel>

            <StackPanel Grid.Column="2" Orientation="Horizontal" Margin="0,0,8,0">
                <Button Style="{StaticResource CaptionButton}" Click="Minimize_Click" ToolTip="最小化">
                    <TextBlock Text="&#xE921;" FontFamily="Segoe MDL2 Assets" FontSize="10" />
                </Button>
                <Button Style="{StaticResource CaptionButton}" Click="Maximize_Click" ToolTip="最大化">
                    <TextBlock Text="&#xE922;" FontFamily="Segoe MDL2 Assets" FontSize="10" />
                </Button>
                <Button Style="{StaticResource CloseCaptionButton}" Click="Close_Click" ToolTip="关闭">
                    <TextBlock Text="&#xE8BB;" FontFamily="Segoe MDL2 Assets" FontSize="10" />
                </Button>
            </StackPanel>
        </Grid>

        <!-- ===================== 内容区 ===================== -->
        <Grid Grid.Row="1" Margin="16,10,16,6">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- 流程属性卡片 -->
            <Border Grid.Row="0" Style="{StaticResource GlassCard}" Padding="14,10" Margin="0,0,0,10">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="230" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="230" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="流程名称:" VerticalAlignment="Center" FontSize="13"
                               Foreground="{StaticResource SubTextBrush}" />
                    <TextBox Grid.Column="1" x:Name="NameBox" Margin="6,0,18,0" />
                    <TextBlock Grid.Column="2" Text="窗口标题:" VerticalAlignment="Center" FontSize="13"
                               Foreground="{StaticResource SubTextBrush}" />
                    <TextBox Grid.Column="3" x:Name="TitleBox" Margin="6,0,0,0"
                             ToolTip="引擎连接目标窗口用的标题；界面「读取文件列表」仍用 settings.json 的 windowTitle，如需一致请同步修改" />
                    <StackPanel Grid.Column="4" Orientation="Horizontal" HorizontalAlignment="Right"
                                VerticalAlignment="Center">
                        <Button x:Name="DefaultBtn" Content="恢复默认流程" Click="ResetDefault_Click"
                                Padding="10,4" FontSize="12" Margin="0,0,10,0" />
                        <Button x:Name="SaveBtn" Content="保存到 workflow.json"
                                Style="{StaticResource PrimaryButton}" Click="Save_Click" />
                    </StackPanel>
                </Grid>
            </Border>

            <!-- 步骤列表卡片 -->
            <Border Grid.Row="1" Style="{StaticResource GlassCard}" Padding="12">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <TextBlock Grid.Row="0" Text="发布步骤（自上而下依次执行）" FontSize="12" FontWeight="Bold"
                               Foreground="{StaticResource SubTextBrush}" Margin="2,0,0,6" />
                    <DataGrid x:Name="StepsGrid" Grid.Row="1"
                              AutoGenerateColumns="False" CanUserAddRows="False" CanUserDeleteRows="False"
                              HeadersVisibility="Column" GridLinesVisibility="Horizontal"
                              HorizontalGridLinesBrush="#338FC8F0" VerticalGridLinesBrush="Transparent"
                              Background="#99FFFFFF" BorderBrush="{StaticResource BorderGlassBrush}" BorderThickness="1"
                              RowBackground="Transparent" AlternatingRowBackground="#338FC8F0"
                              RowHeight="34" ColumnHeaderHeight="30"
                              SelectionMode="Single" SelectionUnit="FullRow"
                              Foreground="{StaticResource TextBrush}" FontSize="13">
                        <DataGrid.Columns>
                            <DataGridTemplateColumn Header="步骤类型" Width="150">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <ComboBox ItemsSource="{Binding Source={StaticResource StepKinds}}"
                                                  SelectedItem="{Binding Kind, UpdateSourceTrigger=PropertyChanged}"
                                                  VerticalAlignment="Center" Margin="2" />
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>

                            <DataGridTemplateColumn Header="参数 (Value)" Width="*">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBox Text="{Binding Value, UpdateSourceTrigger=PropertyChanged}"
                                                 VerticalAlignment="Center" Margin="2"
                                                 ToolTip="支持 @theme / @files / @updateAll 占位" />
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>

                            <DataGridTemplateColumn Header="超时(秒)" Width="86">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBox Text="{Binding TimeoutSec, UpdateSourceTrigger=PropertyChanged}"
                                                 VerticalAlignment="Center" Margin="2" TextAlignment="Center"
                                                 ToolTip="0 = 使用 settings.json 默认值" />
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>

                            <DataGridTemplateColumn Header="失败策略" Width="96">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <ComboBox ItemsSource="{Binding Source={StaticResource FailStrategies}}"
                                                  SelectedItem="{Binding OnFail, UpdateSourceTrigger=PropertyChanged}"
                                                  VerticalAlignment="Center" Margin="2" />
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>

                            <DataGridTemplateColumn Header="重试" Width="64">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBox Text="{Binding MaxRetries, UpdateSourceTrigger=PropertyChanged}"
                                                 VerticalAlignment="Center" Margin="2" TextAlignment="Center"
                                                 ToolTip="onFail=retry 时的最大重试次数" />
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>

                            <DataGridTemplateColumn Header="必须" Width="52">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <CheckBox IsChecked="{Binding Required, UpdateSourceTrigger=PropertyChanged}"
                                                  HorizontalAlignment="Center" VerticalAlignment="Center" />
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>

                            <DataGridTemplateColumn Header="操作" Width="128">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                            <Button Content="↑" Click="MoveUp_Click" Padding="7,1" Margin="2,0"
                                                    FontSize="11" ToolTip="上移" />
                                            <Button Content="↓" Click="MoveDown_Click" Padding="7,1" Margin="2,0"
                                                    FontSize="11" ToolTip="下移" />
                                            <Button Content="✕" Click="DeleteStep_Click" Padding="7,1" Margin="2,0"
                                                    FontSize="11" ToolTip="删除该步骤" />
                                        </StackPanel>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </Border>

            <!-- 添加步骤行 -->
            <Grid Grid.Row="2" Margin="0,10,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="添加步骤:" VerticalAlignment="Center" FontSize="13"
                               Foreground="{StaticResource SubTextBrush}" />
                    <ComboBox x:Name="AddKindBox" Width="140" Margin="8,0,0,0" VerticalAlignment="Center" />
                    <Button Content="添加" Click="AddStep_Click" Margin="8,0,0,0" Padding="12,4" FontSize="12" />
                </StackPanel>
                <TextBlock Grid.Column="1" Text="占位符: @theme 当前主题 · @files 勾选文件列表(CheckFiles 专用) · @updateAll true/false"
                           HorizontalAlignment="Right" VerticalAlignment="Center" FontSize="11"
                           Foreground="{StaticResource SubTextBrush}" />
            </Grid>

            <!-- 状态提示 -->
            <Border Grid.Row="3" Margin="0,10,0,0" Background="#338FC8F0" CornerRadius="8" Padding="10,6">
                <TextBlock x:Name="StatusText" Text="" FontSize="12"
                           Foreground="{StaticResource SubTextBrush}" TextWrapping="Wrap" />
            </Border>
        </Grid>

        <!-- ===================== 底部状态栏 ===================== -->
        <Border Grid.Row="2" Background="#66FFFFFF" BorderThickness="0,1,0,0" BorderBrush="#3380C8FF">
            <TextBlock Margin="16,0" Text="保存后下次点击「开始发布」即按新流程执行"
                       FontSize="12" VerticalAlignment="Center" Foreground="{StaticResource SubTextBrush}" />
        </Border>
    </Grid>
</Window>
